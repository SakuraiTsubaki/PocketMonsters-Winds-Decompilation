{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SakuraiTsubaki/PocketMonsters-Winds-Decompilation/manifests/symbol-map.schema.json",
  "title": "Generation X symbol map",
  "type": "object",
  "required": ["schema_version", "target_id", "module", "symbols"],
  "properties": {
    "schema_version": {"const": 1},
    "target_id": {"type": "string", "minLength": 1},
    "module": {"type": "string", "minLength": 1},
    "module_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "address", "name_status", "verification"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "address": {"type": "string", "pattern": "^0x[0-9A-Fa-f]+$"},
          "size": {"type": ["integer", "null"], "minimum": 0},
          "temporary_name": {"type": ["string", "null"]},
          "semantic_name": {"type": ["string", "null"]},
          "name_status": {"enum": ["unknown", "temporary", "inferred", "verified"]},
          "kind": {"enum": ["function", "data", "vtable", "string", "section", "unknown"]},
          "subsystem": {"type": ["string", "null"]},
          "verification": {"enum": ["Unverified", "Observed", "Reproduced", "Matched"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
